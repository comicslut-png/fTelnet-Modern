{
  "name": "ftelnet",
  "version": "2.0.0-alpha.1",
  "description": "fTelnet: An HTML5 WebSocket client for BBSes and text-mode hosts",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Rick Parrish, R&M Software (original); modernization contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/rickparrish/fTelnet.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:norip:noxfer": "vite build --mode norip-noxfer",
    "build:norip:xfer": "vite build --mode norip-xfer",
    "build:rip:noxfer": "vite build --mode rip-noxfer",
    "build:rip:xfer": "vite build --mode rip-xfer",
    "build:all": "npm run build:norip:noxfer && npm run build:norip:xfer && npm run build:rip:noxfer && npm run build:rip:xfer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "file-saver": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
